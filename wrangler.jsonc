{
  "name": "optimax-studio-v2-team",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-13",
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "database_name": "optimax-studio-v2", "database_id": "REPLACE_AFTER_DATABASE_CREATION"}],
  "vars": {"GITHUB_REPOSITORY": "khairiyasinpc-source/optimax-studio-v2", "GITHUB_BRANCH": "main", "PUBLIC_URL": "https://khairiyasinpc-source.github.io/optimax-studio-v2/"}
}
